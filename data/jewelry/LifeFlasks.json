      "name": {
        "zh-Hant": "戰士之血",
        "zh-Hans": "战士之血",
        "en": "Blood of the Warrior"
      },
      "type1": {
        "zh-Hant": "生命藥劑",
        "zh-Hans": "生命药剂",
        "en": "Life Flask"
      },
      "type2": {
        "zh-Hant": "巨大生命藥劑",
        "zh-Hans": "恢弘生命药剂",
        "en": "Gargantuan Life Flask"
      },
      "imageUrl": "https://cdn.jsdelivr.net/gh/m9588928-maker/PoeII-DataBase--Resources@main/Jewellery/LifeFlasks/Uniques/BloodOfTheKarui.webp",
      "stats": [],
      "affixes": [
        {
          "zh-Hant": "恢復90%更少生命",
          "zh-Hans": "生命回复总降 90%",
          "en": "90% less Life Recovered"
        },
        {
          "zh-Hant": "未保留生命已滿時不移除效果",
          "zh-Hans": "未保留的生命全满时不移除效果",
          "en": "Effect is not removed when Unreserved Life is Filled"
        },
        {
          "zh-Hant": "在效果期間所受傷害的(15—30)%補償為生命",
          "zh-Hans": "效果期间将所受伤害的 (15—30)% 吸纳为生命",
          "en": "(15—30)% of Damage taken during effect Recouped as Life"
        },
        {
          "zh-Hant": "在效果期間內遭敵人擊中時，獲得(3—5)盛怒",
          "zh-Hans": "效果期间被敌人击中时获得 (3—5) 点怒火",
          "en": "Gain (3—5) Rage when Hit by an Enemy during effect"
        },
        {
          "zh-Hant": "效果期間內無固有盛怒損失",
          "zh-Hans": "效果期间不具有固有的怒火损失",
          "en": "No Inherent loss of Rage during effect"
        },
        {
          "zh-Hant": "增加(25—50)%持續時間",
          "zh-Hans": "持续时间提高 (25—50)%",
          "en": "(25—50)% increased Duration"
        }
      ],
      "flavor": {
        "zh-Hant": "\"圖克哈瑪或許早已長眠，但他仍舊給予我們力量。\n一根細針、一份祭品和一只瓶子……\n孩子，好好享受吧，你不只會在接下來的戰鬥存活下來……更會成長茁壯。\"",
        "zh-Hans": "“图克哈马虽然已经沉睡，但依然赐予我们力量。\n一枚细针，一次供奉，一瓶圣液……喝下去吧，我的孩子，\n你不只能在即将到来的战斗中活下去……你必将凯旋。”",
        "en": "\"Tukohama may be asleep, but he still gives us his strength. A small\nneedle, an offering, and a vial... drink deeply, my son, and you\nwill more than survive the coming battle... you will thrive.\""
      },
      "level": 40,
      "_flavorEnabled": true,
      "grantedSkillsExtra": []
    },
